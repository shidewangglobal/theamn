# Sanity CMS (Insights)
# Copy to .env and fill in values from https://sanity.io/manage

# Astro build + Studio (public)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-01-01

# Build-time read token (Viewer permission) — required when dataset is private
SANITY_API_READ_TOKEN=

# Migration only — Editor permission, never commit or deploy to Render
SANITY_API_WRITE_TOKEN=

# Optional Studio aliases (defaults to PUBLIC_* above)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
