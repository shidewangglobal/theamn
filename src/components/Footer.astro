---
const year = new Date().getFullYear();
---

<footer class="section-cream-alt border-t border-amn-brown/10">
  <div class="footer-bar mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-5 md:px-8">
    <a href="/" class="shrink-0">
      <img src="/assets/amn-logo-header-dark.png" alt="the amn" class="h-7 w-auto opacity-90 md:h-8" width="160" height="48" />
    </a>

    <nav class="footer-nav flex flex-wrap items-center gap-5 md:gap-6" aria-label="Footer navigation">
      <a href="/" class="pill-nav-link font-caption text-xs uppercase tracking-wider text-amn-brown/55 transition hover:text-amn-dark">Home</a>
      <a href="/insights" class="pill-nav-link font-caption text-xs uppercase tracking-wider text-amn-brown/55 transition hover:text-amn-dark">Insights</a>
      <a href="/#contact" class="pill-nav-link font-caption text-xs uppercase tracking-wider text-amn-brown/55 transition hover:text-amn-dark">Connect</a>
    </nav>

    <div class="footer-meta flex flex-wrap items-center gap-x-3 gap-y-1 font-caption text-xs text-amn-brown/45">
      <span>&copy; {year} The AMN Limited</span>
      <span class="hidden text-amn-brown/25 sm:inline" aria-hidden="true">·</span>
      <a href="https://theamn.network" class="text-amn-brown/55 transition hover:text-amn-blue">theamn.network</a>
    </div>
  </div>
</footer>

<style>
  .footer-bar {
    row-gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .footer-nav {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
