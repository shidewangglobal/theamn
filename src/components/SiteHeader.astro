---
import HeaderCtaGroup from './HeaderCtaGroup.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  homeHref?: string;
  navLinks: NavLink[];
  connectHref?: string;
  showInsightsLink?: boolean;
}

const {
  homeHref = '/',
  navLinks,
  connectHref = '/#contact',
  showInsightsLink = true,
} = Astro.props;
---

<header class="site-header is-scrolled fixed left-0 right-0 top-0 z-50 border-b border-amn-brown/8 bg-[#f2f0eb]/92 px-4 pt-3 backdrop-blur-md transition-all duration-[600ms] ease-[cubic-bezier(0.22,1,0.36,1)] md:px-6">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
    <a href={homeHref} class="shrink-0">
      <img
        src="/assets/amn-logo-header-dark.png"
        alt="the amn"
        class="h-8 w-auto md:h-9"
        width="160"
        height="48"
      />
    </a>

    <nav class="pill-nav pill-nav--light hidden md:inline-flex" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="pill-nav-link">{link.label}</a>
      ))}
    </nav>

    <div class="hidden shrink-0 md:block">
      <HeaderCtaGroup connectHref={connectHref} showInsights={showInsightsLink} />
    </div>

    <button
      type="button"
      id="mobile-menu-btn"
      class="mobile-menu-btn inline-flex h-10 w-10 items-center justify-center rounded-full border border-amn-brown/10 bg-white/80 backdrop-blur md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg class="h-5 w-5 text-amn-brown" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="mx-auto mt-3 hidden max-w-7xl flex-col gap-1 rounded-3xl border border-amn-brown/10 bg-white/95 p-4 backdrop-blur-xl md:hidden"
    aria-label="Mobile navigation"
  >
    {navLinks.map((link) => (
      <a href={link.href} class="pill-nav-link rounded-2xl px-4 py-3 font-caption text-sm uppercase tracking-wider text-amn-brown/80 hover:bg-amn-cream">
        {link.label}
      </a>
    ))}
    {
      showInsightsLink && (
        <div class="mt-2 border-t border-amn-brown/8 pt-2">
          <HeaderCtaGroup connectHref={connectHref} />
        </div>
      )
    }
    {
      !showInsightsLink && (
        <a href={connectHref} class="pill-nav-link btn-primary mt-1 w-full py-3 text-center text-xs">
          Connect
        </a>
      )
    }
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
