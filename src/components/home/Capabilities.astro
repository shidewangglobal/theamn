---
const capabilities = [
  {
    name: 'Creative & Brand Experience',
    description: 'Make the value of distinctive products unmistakable and give customers compelling reasons to choose them.',
  },
  {
    name: 'Technology & Automation',
    description: 'Access connected digital infrastructure and automation without having to assemble every capability in-house.',
  },
  {
    name: 'Performance & Acquisition',
    description: 'Reach relevant customers and generate measurable demand across digital channels.',
  },
  {
    name: 'Digital Commerce',
    description: 'Turn customer interest into action through stronger websites, landing pages and conversion journeys.',
  },
  {
    name: 'CRM & Customer Lifecycle',
    description: 'Encourage repeat business, deepen customer relationships and unlock more value over time.',
  },
  {
    name: 'Commercial Intelligence',
    description: 'Understand what drives revenue and make informed decisions about where to invest next.',
  },
];
---

<section id="capabilities" class="cap-section tubik-section-alt scroll-mt-28">
  <div class="tubik-shell">
    <div class="cap-layout">
      <div class="cap-intro">
        <p class="reveal section-label">The capabilities behind your growth</p>
        <h2 class="reveal mt-4 font-headline text-3xl font-light leading-[1.12] tracking-tight text-amn-dark md:text-4xl">
          Everything digital growth needs, working as one.
        </h2>
        <p class="reveal mt-4 max-w-sm font-body-secondary text-sm leading-relaxed text-amn-brown/70 md:text-base">
          One investment in expertise. Connected capabilities across the entire customer journey.
        </p>
      </div>

      <ol class="cap-list">
        {
          capabilities.map((item, index) => (
            <li class="cap-row">
              <span class="cap-index font-caption">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="cap-name font-headline">{item.name}</h3>
              <p class="cap-copy font-body-secondary">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .cap-section {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .cap-layout {
    display: grid;
    gap: 2.25rem;
  }

  .cap-list {
    border-top: 1px solid rgba(74, 66, 51, 0.14);
  }

  .cap-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.35rem 1rem;
    align-items: baseline;
    padding: 1.15rem 0 1.2rem;
    border-bottom: 1px solid rgba(74, 66, 51, 0.14);
  }

  .cap-index {
    font-size: 11px;
    letter-spacing: 0.16em;
    color: rgba(74, 66, 51, 0.45);
  }

  .cap-name {
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.25;
    color: #1c1915;
  }

  .cap-copy {
    grid-column: 2;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(74, 66, 51, 0.62);
  }

  @media (min-width: 900px) {
    .cap-section {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }

    .cap-layout {
      grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.35fr);
      gap: 4.5rem;
      align-items: start;
    }

    .cap-intro {
      position: sticky;
      top: 6.5rem;
      padding-top: 0.35rem;
    }

    .cap-row {
      grid-template-columns: 2.25rem minmax(11rem, 0.85fr) minmax(0, 1.15fr);
      column-gap: 1.5rem;
      padding: 1.35rem 0;
    }

    .cap-copy {
      grid-column: auto;
    }

    .cap-name {
      font-size: 1.35rem;
    }
  }
</style>
