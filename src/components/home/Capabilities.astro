---
const capabilities = [
  {
    name: 'Creative & Brand Experience',
    description:
      'Social media and the wider expression of the brand are upgraded with the expertise of the team. The offer becomes more attractive, and it catches attention from the first sight.',
  },
  {
    name: 'Technology & Automation',
    description:
      'Founders do not have to fund a technology build of their own. The partnership covers the systems and the automation the brand needs to operate, learn and scale.',
  },
  {
    name: 'Performance & Acquisition',
    description:
      'Acquisition is planned around the customers worth reaching. Spend, creative and channel sit together, and the demand that comes back can be read in numbers.',
  },
  {
    name: 'Digital Commerce',
    description:
      'Websites, landing pages and the path to purchase are built as one journey, so interest has a natural place to become an enquiry, a booking or a sale.',
  },
  {
    name: 'CRM & Customer Lifecycle',
    description:
      'After the first purchase, the relationship is looked after. The brand stays present in the life of the customer, and more of the value in that relationship is unlocked over time.',
  },
  {
    name: 'Commercial Intelligence',
    description:
      'The numbers are read for what they actually say about revenue. Founders can see what is working, and decide with more confidence where the next effort belongs.',
  },
];
---

<section id="capabilities" class="cap-section tubik-section scroll-mt-28">
  <div class="tubik-shell">
    <div class="cap-layout">
      <div class="cap-intro">
        <p class="reveal section-label">The capabilities behind your growth</p>
        <h2 class="reveal mt-4 font-headline text-3xl font-light leading-[1.12] tracking-tight text-amn-dark md:text-4xl">
          Everything digital growth needs, working as one.
        </h2>
        <p class="reveal mt-4 max-w-sm font-body-secondary text-sm leading-relaxed text-amn-brown/70 md:text-base">
          We invest the right expertise, knowledge and capabilities to make each interaction more relevant, each experience more considered and the path to purchase more natural, from the first impression to the moment a customer returns for more.
        </p>
      </div>

      <ol class="cap-grid">
        {
          capabilities.map((item, index) => (
            <li class="cap-card reveal">
              <span class="cap-index font-caption">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="cap-name font-headline">{item.name}</h3>
              <p class="cap-copy font-body-secondary">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .cap-section {
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .cap-layout {
    display: grid;
    gap: 1.25rem;
  }

  .cap-grid {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cap-card {
    min-width: 0;
    border: 1px solid rgba(74, 66, 51, 0.08);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow: 0 10px 32px rgba(10, 10, 10, 0.045);
    padding: 1.15rem 1.15rem 1.25rem;
  }

  .cap-index {
    display: block;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: #00a0f0;
  }

  .cap-name {
    margin-top: 0.45rem;
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.25;
    color: #1c1915;
  }

  .cap-copy {
    margin-top: 0.45rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(74, 66, 51, 0.72);
  }

  @media (min-width: 900px) {
    .cap-section {
      padding-top: 1.75rem;
      padding-bottom: 1.75rem;
    }

    .cap-layout {
      grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.45fr);
      gap: 1.75rem 2rem;
      align-items: start;
    }

    .cap-intro {
      position: sticky;
      top: 6.5rem;
    }

    .cap-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cap-name {
      font-size: 1.28rem;
    }
  }
</style>
