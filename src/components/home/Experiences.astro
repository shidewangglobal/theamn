---
import { getCollection } from 'astro:content';
import { insightSlug } from '../../utils/insights';

const published = (await getCollection('experiences', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const featured = published.filter((entry) => entry.data.featured);
const journeys = (featured.length ? featured : published).slice(0, 3);
---

<section id="experiences" class="tubik-section-alt scroll-mt-28">
  <div class="tubik-shell">
    <div class="max-w-3xl">
      <p class="reveal section-label mb-2.5">Curated through the AMN network</p>
      <h2 class="reveal font-headline text-3xl font-light leading-[1.12] tracking-tight text-amn-dark md:text-4xl">
        Extraordinary things deserve to be discovered.
      </h2>
      <p class="reveal mt-4 max-w-md font-body-secondary leading-relaxed text-amn-brown/70">
        An edit of places, products and experiences, chosen because they are original.
      </p>
      <a href="/experiences" class="reveal pill-nav-link btn-primary mt-6 w-fit px-6 py-3 text-sm">
        Discover what makes the cut.
      </a>
    </div>

    {
      journeys.length > 0 ? (
        <ul class="mt-2.5 grid gap-2.5 md:grid-cols-3">
          {journeys.map((entry) => (
            <li>
              <a href={`/experiences/${insightSlug(entry.id)}`} class="group block h-full">
                <article class="bento-solid flex h-full flex-col overflow-hidden">
                  <div class="relative aspect-[4/3] overflow-hidden">
                    <img
                      src={entry.data.coverImage}
                      alt=""
                      class="h-full w-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
                      loading="lazy"
                    />
                  </div>
                  <div class="bento-p-md flex flex-1 flex-col">
                    {entry.data.place && (
                      <p class="font-caption text-[10px] uppercase tracking-[0.2em] text-amn-blue">{entry.data.place}</p>
                    )}
                    <h3 class="mt-2 font-headline text-2xl font-light leading-tight text-amn-dark transition group-hover:text-amn-blue">
                      {entry.data.title}
                    </h3>
                    <p class="mt-3 font-body-secondary text-sm leading-relaxed text-amn-brown/70">{entry.data.description}</p>
                  </div>
                </article>
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</section>
