---
const industries = [
  {
    name: 'Hospitality & Travel',
    description: 'Destinations and stays ready to be introduced to more of the guests who would book them.',
    src: '/images/home/focus-hospitality.jpg',
    alt: 'A resort pool at dusk, with lounge chairs and a lit dining terrace',
    tile: 'travel',
  },
  {
    name: 'Luxury Automotive',
    description: 'Marques built on craft, and on a relationship the customer should feel long before a visit.',
    src: '/images/home/focus-auto.jpg',
    alt: 'A white convertible parked under trees on a brick street',
    tile: 'auto',
  },
  {
    name: 'Wellness & Lifestyle',
    description: 'Products and practices made to matter in daily life, ready for a wider circle of people.',
    src: '/images/home/focus-wellness.jpg',
    alt: 'A stone soaking tub in a quiet spa room',
    tile: 'wellness',
  },
  {
    name: 'Exclusive Experiences',
    description: 'Rare occasions that should meet the people willing to travel for them.',
    src: '/images/home/focus-dining.jpg',
    alt: 'A plated dish and wine glasses at a long dinner table',
    tile: 'dining',
  },
  {
    name: 'Premium Real Estate',
    description: 'Properties with a point of view, introduced to buyers who are ready to enquire.',
    src: '/images/home/villa.jpg',
    alt: 'A modern house with a still pool in hard daylight',
    tile: 'estate',
  },
  {
    name: 'Luxury Products',
    description: 'Objects made with a reason to exist, given a public presence equal to the care in their making.',
    src: '/images/home/focus-pearls.jpg',
    alt: 'A pearl necklace resting in an open box',
    tile: 'product',
  },
];
---

<section id="focus" class="tubik-section scroll-mt-28">
  <div class="tubik-shell">
    <div class="focus-head">
      <div class="focus-title-block">
        <p class="section-label mb-2.5">Who we back</p>
        <h2 class="focus-title font-headline font-light leading-[1.12] tracking-tight text-amn-dark">
          <span class="block">Distinctive products. Exceptional</span>
          <span class="focus-title-line">experiences. <span class="headline-italic">Ambitious founders.</span></span>
        </h2>
      </div>
      <div class="focus-lede font-body-secondary">
        <p>Original brands are built on conviction, craft and a distinct point of view. We partner with founders who see greater possibilities in what they've created, investing our expertise and media in their next stage of growth.</p>
      </div>
    </div>

    <div class="focus-atlas">
      {
        industries.map((item) => (
          <figure class:list={['focus-tile', 'bento-image', item.tile]}>
            <img src={item.src} alt={item.alt} class="h-full w-full object-cover" loading="lazy" />
            <figcaption class="focus-caption">
              <span class="block font-headline text-xl font-light leading-tight text-white sm:text-2xl">{item.name}</span>
              <span class="mt-1.5 block max-w-md font-body-secondary text-[0.8125rem] leading-snug text-white/80">{item.description}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .focus-head {
    display: grid;
    gap: 1.15rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .focus-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: 0.625rem;
      margin-bottom: 0.625rem;
    }
  }

  @media (min-width: 1100px) {
    .focus-head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .focus-title-block {
      grid-column: 1 / span 7;
    }

    .focus-lede {
      grid-column: 8 / span 5;
    }
  }

  .focus-title {
    max-width: 36rem;
    font-size: clamp(1.15rem, 6.15vw, 2.25rem);
  }

  .focus-title-line {
    display: block;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .focus-title {
      font-size: 2.25rem;
    }
  }

  .focus-lede {
    max-width: none;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(74, 66, 51, 0.72);
  }

  @media (min-width: 768px) {
    .focus-lede {
      justify-self: stretch;
    }
  }

  .focus-atlas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.625rem;
    max-width: 100%;
    min-width: 0;
  }

  .focus-tile {
    position: relative;
    min-width: 0;
    min-height: 12rem;
    overflow: hidden;
  }

  .focus-tile img {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .focus-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    line-height: 1.25;
    padding: 4.5rem 1.1rem 1rem;
    background: linear-gradient(to top, rgba(8, 10, 12, 0.82) 0%, rgba(8, 10, 12, 0.35) 62%, transparent 100%);
  }

  .travel {
    min-height: 16rem;
  }

  @media (min-width: 768px) {
    .focus-atlas {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .travel,
    .product {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .focus-atlas {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .travel {
      grid-column: span 7;
      grid-row: span 2;
      min-height: 22rem;
    }

    .auto,
    .wellness {
      grid-column: span 5;
      min-height: 10.5rem;
    }

    .dining,
    .estate,
    .product {
      grid-column: span 4;
      min-height: 11rem;
    }
  }
</style>
