---
const terms = [
  {
    name: 'Partner',
    description: 'Align on the opportunity, and on what the next stage of growth should be.',
  },
  {
    name: 'Invest',
    description: 'Media and expertise are committed before the revenue arrives, so the work can begin.',
  },
  {
    name: 'Share',
    description: 'When revenue grows, both sides share it on terms set in advance.',
  },
];
---

<section id="model" class="tubik-section scroll-mt-28">
  <div class="tubik-shell">
    <div class="model-band">
      <p class="font-caption text-[10px] uppercase tracking-[0.22em] text-white/55">Expertise-led investment</p>
      <h2 class="mt-3 font-headline font-light leading-tight text-white">
        <span class="block text-3xl md:text-4xl lg:text-5xl">Brands get invested in.</span>
        <span class="model-revenue headline-italic">The AMN grows through revenue.</span>
      </h2>
      <p class="mt-4 max-w-2xl font-body-secondary text-base leading-relaxed text-white/75 md:text-lg">
        The brand brings the product and the point of view. The partnership brings media, expertise and the systems that put them to work. As revenue grows, it is shared.
      </p>

      <ol class="model-terms">
        {
          terms.map((term, index) => (
            <li>
              <p class="model-index font-caption text-[10px] uppercase tracking-[0.22em]">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-2 font-headline text-2xl font-light text-white md:text-3xl">{term.name}</h3>
              <p class="mt-2 font-body-secondary text-sm leading-relaxed text-white/70">{term.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .model-revenue {
    display: block;
    margin-top: 0.15em;
    max-width: 100%;
    font-size: clamp(1.35rem, 6.4vw, 3rem);
    color: #5eb4ff;
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .model-revenue {
      white-space: nowrap;
      font-size: clamp(1.05rem, 2.55vw, 3rem);
    }
  }

  .model-index {
    color: #00a0f0;
  }

  .model-band {
    border-radius: 1.5rem;
    background:
      radial-gradient(ellipse 80% 120% at 0% 100%, rgba(0, 130, 195, 0.28), transparent 55%),
      #121816;
    padding: 1.75rem 1.5rem 2rem;
  }

  .model-terms {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 768px) {
    .model-band {
      padding: 2.5rem 2.75rem 2.75rem;
    }

    .model-terms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
</style>
