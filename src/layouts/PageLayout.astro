---
import '../styles/global.css';
import '../styles/theme-preview.css';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { siteGraph } from '../lib/seo/site';
import SiteTracking from '../components/SiteTracking.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  nofollow?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/images/hero-cover.jpeg',
  ogType = 'website',
  ogTitle,
  ogDescription,
  twitterCard = 'summary_large_image',
  twitterTitle,
  twitterDescription,
  twitterImage,
  canonicalUrl,
  noindex = false,
  nofollow = false,
  articlePublishedTime,
  articleModifiedTime,
  jsonLd,
} = Astro.props;

const siteName = 'the amn';
const siteUrl = 'https://theamn.network';
const documentTitle =
  title.includes('The AMN') || title.includes('the amn') ? title : `${title} | ${siteName}`;
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const resolvedOgTitle = ogTitle ?? documentTitle;
const resolvedOgDescription = ogDescription ?? description;
const resolvedTwitterTitle = twitterTitle ?? resolvedOgTitle;
const resolvedTwitterDescription = twitterDescription ?? resolvedOgDescription;

const toAbsoluteUrl = (value: string) => (value.startsWith('http') ? value : `${siteUrl}${value}`);
const ogImageUrl = toAbsoluteUrl(ogImage);
const twitterImageUrl = toAbsoluteUrl(twitterImage ?? ogImage);

const robotsDirectives = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
].join(', ');

const structuredData = siteGraph(
  {
    url: resolvedCanonical,
    name: documentTitle,
    description,
  },
  jsonLd,
);

const pageNavLinks = [
  { href: '/#growth', label: 'Growth' },
  { href: '/#capabilities', label: 'Capabilities' },
  { href: '/#model', label: 'Model' },
  { href: '/#focus', label: 'Focus' },
  { href: '/#vision', label: 'Vision' },
];
---

<!doctype html>
<html lang="en" class="theme-preview">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirectives} />
    <link rel="canonical" href={resolvedCanonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content="https://theamn.network" />}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedTwitterTitle} />
    <meta name="twitter:description" content={resolvedTwitterDescription} />
    <meta name="twitter:image" content={twitterImageUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <SiteTracking />
  </head>
  <body class="theme-preview min-h-screen overflow-x-hidden text-amn-brown">
    <SiteHeader homeHref="/" navLinks={pageNavLinks} connectHref="/#contact" showInsightsLink={true} />

    <main class="page-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-main {
    padding-top: 5.25rem;
  }
</style>
