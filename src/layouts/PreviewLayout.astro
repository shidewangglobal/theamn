---
import '../styles/global.css';
import '../styles/theme-preview.css';
import HeaderCtaGroup from '../components/HeaderCtaGroup.astro';
import { siteGraph } from '../lib/seo/site';
import SiteTracking from '../components/SiteTracking.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  title?: string;
  description?: string;
  navLinks?: NavLink[];
  logoHref?: string;
  showInsights?: boolean;
  insightsLabel?: string;
  insightsHref?: string;
  connectHref?: string;
  connectLabel?: string;
  showMarketing?: boolean;
  marketingHref?: string;
  marketingLabel?: string;
  ogImage?: string;
}

const {
  title = 'The AMN | Build Demand. Share Revenue.',
  description = 'Original brands, backed with media and expertise, so the story can meet a wider public and the revenue that follows is shared.',
  navLinks = [
    { href: '#growth', label: 'Growth' },
    { href: '#capabilities', label: 'Capabilities' },
    { href: '#model', label: 'Model' },
    { href: '#focus', label: 'Focus' },
    { href: '#vision', label: 'Vision' },
  ],
  logoHref = '#hero',
  showInsights = true,
  insightsLabel = 'Insights',
  insightsHref = '/insights',
  connectHref = '#contact',
  connectLabel = 'Partner',
  showMarketing = true,
  marketingHref = '/marketing',
  marketingLabel = 'Marketing services',
  ogImage = '/images/home/hero-positano.jpg',
} = Astro.props;

const siteName = 'the amn';
const siteUrl = 'https://theamn.network';
const fullTitle = title.includes('The AMN') || title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const structuredData = siteGraph({
  url: canonicalURL.toString(),
  name: fullTitle,
  description,
});
---

<!doctype html>
<html lang="en" class="theme-preview">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <SiteTracking />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="theme-preview min-h-screen overflow-x-hidden text-amn-brown">
    <header id="site-header" class="site-header is-scrolled fixed left-0 right-0 top-0 z-50 px-4 pt-3 transition-all duration-[600ms] ease-[cubic-bezier(0.22,1,0.36,1)] md:px-6">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
        <a href={logoHref} class="shrink-0">
          <img
            id="header-logo"
            src="/assets/amn-logo-header-dark.png"
            alt="the amn"
            class="h-8 w-auto transition-opacity duration-[350ms] ease-[cubic-bezier(0.22,1,0.36,1)] md:h-9"
            width="160"
            height="48"
          />
        </a>

        <nav id="pill-nav" class="pill-nav pill-nav--light hidden md:inline-flex" aria-label="Main navigation">
          {navLinks.map((link) => (
            <a href={link.href} class="pill-nav-link">{link.label}</a>
          ))}
        </nav>

        <div class="hidden shrink-0 md:block">
          <HeaderCtaGroup
            connectHref={connectHref}
            connectLabel={connectLabel}
            showInsights={showInsights}
            insightsHref={insightsHref}
            insightsLabel={insightsLabel}
            showMarketing={showMarketing}
            marketingHref={marketingHref}
            marketingLabel={marketingLabel}
          />
        </div>

        <button
          id="mobile-menu-btn"
          class="mobile-menu-btn inline-flex h-10 w-10 items-center justify-center rounded-full border backdrop-blur md:hidden"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <nav
        id="mobile-menu"
        class="mx-auto mt-3 hidden max-w-7xl flex-col gap-1 rounded-3xl border border-amn-brown/10 bg-white/95 p-4 backdrop-blur-xl md:hidden"
        aria-label="Mobile navigation"
      >
        {navLinks.map((link) => (
          <a href={link.href} class="pill-nav-link rounded-2xl px-4 py-3 font-caption text-sm uppercase tracking-wider text-amn-brown/80">
            {link.label}
          </a>
        ))}
        <div class="mt-2 border-t border-amn-brown/8 pt-2">
          <HeaderCtaGroup
            connectHref={connectHref}
            connectLabel={connectLabel}
            showInsights={showInsights}
            insightsHref={insightsHref}
            insightsLabel={insightsLabel}
            showMarketing={showMarketing}
            marketingHref={marketingHref}
            marketingLabel={marketingLabel}
          />
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <script>
      import { initAnimations } from '../scripts/animations';
      initAnimations();

      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        const isOpen = !mobileMenu?.classList.contains('hidden');
        mobileMenu?.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!isOpen));
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.add('hidden');
          menuBtn?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>
