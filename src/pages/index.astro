---
import PreviewLayout from '../layouts/PreviewLayout.astro';
import Hero from '../components/Hero.astro';
import Belief from '../components/home/Belief.astro';
import Model from '../components/home/Model.astro';
import Capabilities from '../components/home/Capabilities.astro';
import Investment from '../components/home/Investment.astro';
import Focus from '../components/home/Focus.astro';
import Vision from '../components/home/Vision.astro';
import Standard from '../components/home/Standard.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<PreviewLayout>
  <Hero variant="partner" />
  <Belief />
  <Model />
  <Capabilities />
  <Investment />
  <Focus />
  <Vision />
  <Standard />
  <Contact
    eyebrow="Explore a partnership"
    headline="Built something worth growing?"
    lede="If your brand has a distinctive product, a commitment to exceptional experiences and the ambition to grow digitally, let's explore what we could build together."
  />
  <Footer />
</PreviewLayout>
