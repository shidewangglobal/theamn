---
import PageLayout from '../../layouts/PageLayout.astro';
import InsightTitle from '../../components/InsightTitle.astro';
import { organizationId } from '../../lib/seo/site';
import { getPublishedInsights, getMarkdownInsightContent } from '../../lib/insights/repository';

export async function getStaticPaths() {
  const insights = await getPublishedInsights();
  return insights.map((insight) => ({
    params: { slug: insight.slug },
    props: { insight },
  }));
}

const { insight } = Astro.props;
const { data, slug, source, bodyHtml } = insight;
const seo = data.seo;

const markdownContent =
  source === 'markdown' ? await getMarkdownInsightContent(slug) : null;
const Content = markdownContent?.Content;

const allInsights = await getPublishedInsights();
const sectionInsights = allInsights
  .filter((item) => item.data.section === data.section)
  .sort((a, b) =>
    data.section === 'Growing brands'
      ? a.data.publishDate.valueOf() - b.data.publishDate.valueOf()
      : b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
const relatedInsights = [
  ...sectionInsights.filter((item) => item.slug !== slug),
  ...allInsights.filter((item) => item.slug !== slug && item.data.section !== data.section),
];

const sectionLabel = data.section;
const sectionHash = data.section === 'Growing brands' ? 'growing-brands' : 'seo';
const sectionUrl = `https://theamn.network/insights#${sectionHash}`;
const isGrowing = data.section === 'Growing brands';

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const ensureQuestionMark = (question: string) =>
  question.trim().endsWith('?') ? question.trim() : `${question.trim()}?`;

const isQaArticle = data.category === 'Q&A';

const insightUrl = seo.canonicalUrl ?? `https://theamn.network/insights/${slug}`;

const faqSchema = data.faqs.map((item) => ({
  '@type': 'Question',
  name: ensureQuestionMark(item.question),
  acceptedAnswer: {
    '@type': 'Answer',
    text: item.answer,
  },
}));

const articleJsonLd = {
  '@type': 'Article',
  '@id': `${insightUrl}#article`,
  headline: data.title,
  description: data.description,
  articleSection: `Marketing / ${sectionLabel}`,
  inLanguage: 'en',
  isAccessibleForFree: true,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  url: insightUrl,
  image: seo.ogImage,
  author: { '@id': organizationId },
  publisher: { '@id': organizationId },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${insightUrl}#webpage` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.insight-deck', '.insight-prose h2', '.insight-faq__answer'],
  },
};

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://theamn.network',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Marketing',
      item: 'https://theamn.network/marketing',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: sectionLabel,
      item: sectionUrl,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: data.title,
      item: insightUrl,
    },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleJsonLd,
    breadcrumbJsonLd,
    {
      '@type': 'FAQPage',
      mainEntity: faqSchema,
    },
  ],
};
---

<PageLayout
  title={seo.title}
  description={seo.description}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImage={seo.ogImage}
  twitterCard={seo.twitterCard}
  twitterTitle={seo.twitterTitle}
  twitterDescription={seo.twitterDescription}
  twitterImage={seo.twitterImage}
  canonicalUrl={seo.canonicalUrl}
  noindex={seo.noindex}
  nofollow={seo.nofollow}
  ogType="article"
  articlePublishedTime={data.publishDate.toISOString()}
  articleModifiedTime={(data.updatedDate ?? data.publishDate).toISOString()}
  jsonLd={jsonLd}
>
  <script is:inline define:vars={{ articleSlug: slug, articleTitle: data.title, articleSection: sectionLabel }}>
    window.gtag?.('event', 'article_view', {
      article_slug: articleSlug,
      article_title: articleTitle,
      article_section: articleSection,
    });
    window.fbq?.('track', 'ViewContent', {
      content_name: articleTitle,
      content_category: articleSection,
      content_type: 'article',
    });
  </script>
  <article class:list={['insight-article tubik-section', isQaArticle && 'insight-article--qa']}>
    <div class="tubik-shell insight-article__shell">
      <a href={`/insights#${sectionHash}`} class="insight-back font-caption text-xs uppercase tracking-wider text-amn-brown/50 transition hover:text-amn-blue">
        ← Marketing / {sectionLabel}
      </a>

      <header class="insight-header mt-4 max-w-4xl">
        <InsightTitle
          as="h1"
          title={data.title}
          titleEmphasis={data.titleEmphasis}
          size="article"
        />
        <time
          class="mt-4 block font-caption text-[10px] uppercase tracking-wider text-amn-brown/45"
          datetime={data.publishDate.toISOString()}
        >
          {formatDate(data.publishDate)}
        </time>
        <p class="mt-2 font-caption text-[10px] uppercase tracking-wider text-amn-brown/45">
          Published by {data.author}
        </p>
      </header>

      <div class="insight-cover mt-8 overflow-hidden rounded-[1.25rem] border border-amn-brown/10">
        <img
          src={data.coverImage}
          alt={data.coverAlt || data.title}
          class="insight-cover__image h-full w-full object-cover"
          width="1400"
          height="700"
          loading="eager"
        />
      </div>

      <div class="insight-article__body mt-8 lg:mt-10">
        <div class="insight-main min-w-0">
          <p class="insight-deck font-body-secondary text-lg leading-relaxed text-amn-brown/75 md:text-xl">
            {data.description}
          </p>

          <div class:list={['insight-prose mt-8 font-body-secondary text-amn-brown/85', isQaArticle && 'insight-prose--qa']}>
            {source === 'sanity' && bodyHtml ? (
              <div set:html={bodyHtml} />
            ) : (
              Content && <Content />
            )}
          </div>

          {!isQaArticle && (
          <section class="insight-faq mt-10 border-t border-amn-brown/10 pt-8" aria-labelledby="insight-faq-heading">
            <p class="font-caption text-[10px] uppercase tracking-[0.2em] text-amn-blue">Common questions</p>
            <h2 id="insight-faq-heading" class="insight-faq__title font-headline-bold mt-2 text-2xl text-amn-dark md:text-[1.65rem]">
              Questions owners ask us
            </h2>
            <ul class="insight-faq__list mt-5 space-y-3">
              {data.faqs.map((item) => (
                <li class="insight-faq__item">
                  <details class="insight-faq__details group">
                    <summary class="insight-faq__question font-headline-bold cursor-pointer list-none text-base leading-snug text-amn-dark md:text-[1.05rem]">
                      <span class="insight-faq__question-text">{ensureQuestionMark(item.question)}</span>
                      <span class="insight-faq__icon" aria-hidden="true" />
                    </summary>
                    <p class="insight-faq__answer mt-3 font-body-secondary text-base leading-relaxed text-amn-brown/80">
                      {item.answer}
                    </p>
                  </details>
                </li>
              ))}
            </ul>
          </section>
          )}

          <section class="insight-closing mt-10 border-t border-amn-brown/10 pt-8" aria-labelledby="insight-closing-heading">
            <h2 id="insight-closing-heading" class="font-headline-bold text-xl text-amn-dark md:text-2xl">
              {data.closingTitle}
            </h2>
            <p class="insight-closing__text mt-3 font-body-secondary text-base leading-relaxed text-amn-brown/80">
              {data.closing}
            </p>
            <p class="insight-closing__links mt-4 font-body-secondary text-sm leading-relaxed text-amn-brown/75">
              {isGrowing ? (
                <a href="/#contact" class="text-amn-blue underline-offset-2 transition hover:underline">
                  Explore a partnership
                </a>
              ) : (
                <a
                  href="https://geoauditor.theamn.network/"
                  class="text-amn-blue underline-offset-2 transition hover:underline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Run a free GEO audit
                </a>
              )}
              <span class="text-amn-brown/30" aria-hidden="true"> · </span>
              <a href={`/insights#${sectionHash}`} class="text-amn-blue underline-offset-2 transition hover:underline">
                Marketing / {sectionLabel}
              </a>
            </p>
          </section>
        </div>

        <aside class="insight-aside" aria-label="Article sidebar">
          <div class="insight-aside__inner">
            <div class="insight-aside-card insight-aside-card--cta">
              {isGrowing ? (
                <>
                  <p class="font-caption text-[10px] uppercase tracking-[0.18em] text-amn-brown/45">
                    Partnership
                  </p>
                  <p class="mt-2 font-headline-bold text-lg leading-snug text-amn-dark">
                    Built something worth growing?
                  </p>
                  <p class="mt-2 font-body-secondary text-sm leading-relaxed text-amn-brown/70">
                    The AMN backs selected brands with media and expertise, and shares the revenue that follows.
                  </p>
                  <a href="/#contact" class="pill-nav-link btn-primary mt-4 block px-5 py-3 text-center text-sm">
                    Explore a partnership
                  </a>
                </>
              ) : (
                <>
                  <p class="font-caption text-[10px] uppercase tracking-[0.18em] text-amn-brown/45">
                    Free quick scan
                  </p>
                  <p class="mt-2 font-headline-bold text-lg leading-snug text-amn-dark">
                    See if AI recommends your hotel
                  </p>
                  <p class="mt-2 font-body-secondary text-sm leading-relaxed text-amn-brown/70">
                    Run a free GEO audit in about 30 seconds.
                  </p>
                  <a
                    href="https://geoauditor.theamn.network/"
                    class="pill-nav-link btn-primary mt-4 block px-5 py-3 text-center text-sm"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Check your brand performance in less than 30s.
                  </a>
                  <a href="/#contact" class="pill-nav-link btn-dark mt-2 block px-5 py-3 text-center text-sm">
                    Connect
                  </a>
                </>
              )}
            </div>

            {
              relatedInsights.length > 0 && (
                <div class="insight-aside-card insight-aside-card--related">
                  <p class="font-caption text-[10px] uppercase tracking-[0.18em] text-amn-brown/45">
                    More articles
                  </p>
                  <ul class="insight-related-grid mt-3">
                    {relatedInsights.map((item) => (
                      <li>
                        <a href={`/insights/${item.slug}`} class="insight-related-card group">
                          <span class="insight-related-card__media">
                            <img
                              src={item.data.coverImage}
                              alt=""
                              width="80"
                              height="80"
                              loading="lazy"
                            />
                          </span>
                          <InsightTitle
                            as="span"
                            title={item.data.title}
                            titleEmphasis={item.data.titleEmphasis}
                            size="related"
                            class="block transition group-hover:text-amn-blue"
                          />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
        </aside>
      </div>
    </div>
  </article>
</PageLayout>

<style>
  .insight-cover {
    @apply relative aspect-[21/9] min-h-[12rem] bg-[#f5f5f7] md:min-h-[16rem] lg:min-h-[18rem];
  }

  .insight-article__body {
    @apply grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(17rem,20rem)] lg:gap-10 xl:grid-cols-[minmax(0,1fr)_22rem] xl:gap-12;
  }

  .insight-main {
    @apply max-w-3xl lg:max-w-none;
  }

  .insight-aside__inner {
    @apply flex flex-col gap-4 lg:sticky lg:top-24;
  }

  .insight-aside-card {
    @apply rounded-[1.15rem] border border-amn-brown/10 bg-white p-5;
    box-shadow: 0 8px 28px rgba(10, 10, 10, 0.04);
  }

  .insight-aside-card--related {
    @apply px-3.5 py-3.5;
  }

  .insight-related-grid {
    @apply grid gap-2.5;
  }

  .insight-related-card {
    @apply flex items-center gap-2.5;
  }

  .insight-related-card__media {
    @apply relative block h-9 w-9 shrink-0 overflow-hidden rounded-md bg-[#f5f5f7];
  }

  .insight-related-card__media img {
    @apply h-full w-full object-cover;
  }

  .insight-related-card :global(.insight-title) {
    @apply mt-0 text-[0.8125rem] leading-snug;
  }

  .insight-aside-card--cta {
    border-color: rgba(0, 160, 240, 0.14);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.98) 0%, rgba(245, 245, 247, 0.94) 100%);
  }

  .insight-related {
    @apply rounded-xl border border-transparent px-2 py-2 transition;
  }

  .insight-related:hover {
    @apply border-amn-brown/10 bg-black/[0.03];
  }

  .insight-prose :global(h2) {
    @apply font-headline-bold mb-4 mt-8 text-xl text-amn-dark md:text-2xl;
  }

  .insight-prose--qa :global(h2) {
    @apply font-headline font-light leading-snug tracking-tight;
  }

  .insight-prose--qa :global(h2 em) {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
  }

  .insight-prose :global(p) {
    @apply mb-4 text-base leading-relaxed;
  }

  .insight-prose :global(strong) {
    @apply font-medium text-amn-dark;
  }

  .insight-prose :global(ul),
  .insight-prose :global(ol) {
    @apply mb-4 ml-5 list-disc space-y-2;
  }

  .insight-prose :global(table) {
    @apply mb-6 w-full border-collapse text-sm;
  }

  .insight-prose :global(th),
  .insight-prose :global(td) {
    @apply border border-amn-brown/15 px-3 py-2 text-left;
  }

  .insight-prose :global(th) {
    @apply bg-white/60 font-medium text-amn-dark;
  }

  .insight-prose :global(a) {
    @apply text-amn-blue underline-offset-2 transition hover:underline;
  }

  .insight-prose :global(hr) {
    @apply my-8 border-amn-brown/10;
  }

  .insight-prose :global(.insight-figure) {
    @apply my-8 overflow-hidden rounded-[1rem] border border-amn-brown/10 bg-white;
  }

  .insight-prose :global(.insight-figure__image) {
    @apply h-auto w-full object-cover;
  }

  .insight-prose :global(.insight-figure__caption) {
    @apply px-4 py-3 font-caption text-xs text-amn-brown/60;
  }

  .insight-prose :global(.insight-callout) {
    @apply my-8 rounded-[1rem] border px-5 py-4;
  }

  .insight-prose :global(.insight-callout--info) {
    @apply border-amn-blue/15 bg-[#f5f5f7];
  }

  .insight-prose :global(.insight-callout--cta) {
    border-color: rgba(0, 160, 240, 0.2);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.98) 0%, rgba(245, 245, 247, 0.94) 100%);
  }

  .insight-prose :global(.insight-callout__title) {
    @apply font-headline-bold text-base text-amn-dark md:text-lg;
  }

  .insight-prose :global(.insight-callout p) {
    @apply mb-3 text-sm leading-relaxed text-amn-brown/75;
  }

  .insight-prose :global(.insight-callout__btn) {
    @apply inline-block px-5 py-2.5 text-sm no-underline;
  }

  .insight-prose :global(.insight-pull-quote) {
    @apply my-8 border-l-4 border-amn-blue/40 py-1 pl-5;
  }

  .insight-prose :global(.insight-pull-quote p) {
    @apply font-headline text-xl leading-snug text-amn-dark md:text-2xl;
  }

  .insight-prose :global(.insight-pull-quote__attr) {
    @apply mt-3 block font-caption text-xs not-italic uppercase tracking-wider text-amn-brown/50;
  }

  .insight-faq__item {
    @apply overflow-hidden rounded-[1rem] border border-amn-brown/10 bg-white;
  }

  .insight-faq__details {
    @apply px-4 py-4 md:px-5 md:py-4;
  }

  .insight-faq__question {
    @apply flex items-start justify-between gap-4;
  }

  .insight-faq__question::-webkit-details-marker {
    display: none;
  }

  .insight-faq__icon {
    @apply relative mt-1 h-4 w-4 shrink-0 rounded-full border border-amn-brown/20 bg-white;
  }

  .insight-faq__icon::before,
  .insight-faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.5rem;
    height: 1px;
    background: rgba(74, 66, 51, 0.55);
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }

  .insight-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .insight-faq__details[open] .insight-faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
    opacity: 0;
  }
</style>
