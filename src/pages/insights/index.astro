---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { insightSlug } from '../../utils/insights';

const insights = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const featured =
  insights.find((entry) => entry.data.featured) ?? insights[0] ?? null;
const gridInsights = featured
  ? insights.filter((entry) => entry.id !== featured.id)
  : insights;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PageLayout
  title="Insights | Luxury marketing & GEO"
  description="Insights, guides, and Q&A on SEO, Generative Engine Optimization, and digital marketing for luxury hospitality brands."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'THE AMN Insights',
    url: 'https://theamn.network/insights',
    publisher: {
      '@type': 'Organization',
      name: 'The AMN Limited',
      url: 'https://theamn.network',
    },
  }}
>
  <section class="insights-page tubik-section">
    <div class="tubik-shell">
      <header class="insights-masthead">
        <p class="section-label mb-3 text-accent-italic">Editorial</p>
        <h1 class="insights-title font-headline-bold text-amn-dark">Insights</h1>
        <p class="insights-lede mt-4 max-w-xl font-body-secondary text-base leading-relaxed text-amn-brown/70 md:text-lg">
          Thought leadership on SEO, Generative Engine Optimization, and performance
          marketing for premium hotels and resorts.
        </p>
      </header>

      {
        insights.length === 0 ? (
          <p class="font-body-secondary text-amn-brown/60">New insights coming soon.</p>
        ) : (
          <>
            {
              featured && (
                <a
                  href={`/insights/${insightSlug(featured.id)}`}
                  class="insight-featured group"
                >
                  <div class="insight-featured__media">
                    <img
                      src={featured.data.coverImage}
                      alt=""
                      class="insight-featured__image"
                      loading="eager"
                      width="1200"
                      height="800"
                    />
                  </div>
                  <div class="insight-featured__body">
                    <p class="insight-card__category font-caption text-[10px] uppercase tracking-[0.2em] text-amn-blue">
                      {featured.data.category}
                    </p>
                    <h2 class="insight-featured__title font-headline-bold text-amn-dark transition group-hover:text-amn-blue">
                      {featured.data.title}
                    </h2>
                    <time
                      class="insight-card__date mt-3 block font-caption text-[10px] uppercase tracking-[0.16em] text-amn-brown/45"
                      datetime={featured.data.publishDate.toISOString()}
                    >
                      {formatDate(featured.data.publishDate)}
                    </time>
                  </div>
                </a>
              )
            }

            {
              gridInsights.length > 0 && (
                <ul class="insights-grid">
                  {gridInsights.map((entry) => (
                    <li>
                      <a
                        href={`/insights/${insightSlug(entry.id)}`}
                        class="insight-card group"
                      >
                        <div class="insight-card__media">
                          <img
                            src={entry.data.coverImage}
                            alt=""
                            class="insight-card__image"
                            loading="lazy"
                            width="800"
                            height="600"
                          />
                        </div>
                        <div class="insight-card__body">
                          <p class="insight-card__category font-caption text-[10px] uppercase tracking-[0.2em] text-amn-blue">
                            {entry.data.category}
                          </p>
                          <h2 class="insight-card__title font-headline-bold text-amn-dark transition group-hover:text-amn-blue">
                            {entry.data.title}
                          </h2>
                          <time
                            class="insight-card__date font-caption text-[10px] uppercase tracking-[0.16em] text-amn-brown/45"
                            datetime={entry.data.publishDate.toISOString()}
                          >
                            {formatDate(entry.data.publishDate)}
                          </time>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </>
        )
      }

      <aside class="insights-cta-strip">
        <div class="insights-cta-strip__copy">
          <p class="font-caption text-[10px] uppercase tracking-[0.2em] text-amn-brown/45">
            Free quick scan
          </p>
          <p class="mt-2 font-headline-bold text-xl text-amn-dark md:text-2xl">
            See if AI recommends your hotel
          </p>
          <p class="mt-2 max-w-md font-body-secondary text-sm leading-relaxed text-amn-brown/70">
            Run a free GEO audit and see where your property stands in AI search — in about 30 seconds.
          </p>
        </div>
        <a
          href="https://geoauditor.theamn.network/"
          class="pill-nav-link btn-primary insights-cta-strip__btn shrink-0 px-6 py-3.5 text-sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          Check your brand performance in less than 30s.
        </a>
      </aside>
    </div>
  </section>
</PageLayout>

<style>
  .insights-page {
    @apply pb-8 md:pb-12;
  }

  .insights-masthead {
    @apply mb-8 md:mb-12;
  }

  .insights-title {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .insight-featured {
    @apply mb-8 grid overflow-hidden rounded-[1.25rem] border border-amn-brown/10 bg-white md:mb-10;
    box-shadow: 0 12px 40px rgba(10, 10, 10, 0.05);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  @media (min-width: 768px) {
    .insight-featured {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      min-height: 22rem;
    }
  }

  .insight-featured:hover {
    @apply border-amn-blue/20;
    box-shadow: 0 16px 48px rgba(10, 10, 10, 0.08);
  }

  .insight-featured__media {
    @apply relative min-h-[14rem] overflow-hidden bg-amn-cream;
  }

  .insight-featured__image,
  .insight-card__image {
    @apply absolute inset-0 h-full w-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)];
  }

  .group:hover .insight-featured__image,
  .group:hover .insight-card__image {
    transform: scale(1.04);
  }

  .insight-featured__body {
    @apply flex flex-col justify-center px-6 py-6 md:px-8 md:py-8;
  }

  .insight-featured__title {
    @apply mt-2 text-2xl leading-tight md:text-3xl;
  }

  .insights-grid {
    @apply grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6;
  }

  .insight-card {
    @apply flex h-full flex-col overflow-hidden rounded-[1.15rem] border border-amn-brown/10 bg-white;
    box-shadow: 0 8px 28px rgba(10, 10, 10, 0.04);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .insight-card:hover {
    @apply border-amn-blue/20;
    box-shadow: 0 12px 36px rgba(10, 10, 10, 0.07);
  }

  .insight-card__media {
    @apply relative aspect-[4/3] overflow-hidden bg-amn-cream;
  }

  .insight-card__body {
    @apply flex flex-1 flex-col px-4 py-4 md:px-5 md:py-5;
  }

  .insight-card__title {
    @apply mt-2 mb-3 flex-1 text-lg leading-snug md:text-xl;
  }

  .insight-card__date {
    @apply mt-auto;
  }

  .insights-cta-strip {
    @apply mt-10 flex flex-col items-start justify-between gap-5 rounded-[1.25rem] border border-amn-blue/10 bg-white/80 px-6 py-6 md:mt-14 md:flex-row md:items-center md:gap-8 md:px-8 md:py-8;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(242, 240, 235, 0.92) 100%);
  }

  .insights-cta-strip__btn {
    white-space: normal;
    line-height: 1.35;
    text-align: center;
  }
</style>
