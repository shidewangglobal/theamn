---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Pillars from '../../components/Pillars.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import TechEcosystem from '../../components/TechEcosystem.astro';
import Services from '../../components/Services.astro';
import Collective from '../../components/Collective.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#pillars', label: 'Pillars' },
  { href: '#how-we-work', label: 'Work' },
  { href: '#tech', label: 'Tech' },
  { href: '#services', label: 'Services' },
  { href: '#collective', label: 'Collective' },
];
---

<PreviewLayout
  title="The AMN | Authentic. Agile. Accelerated."
  description="THE AMN elevates multi-market revenue and direct bookings for premium hotels and resorts through AI-driven digital marketing operations."
  navLinks={navLinks}
  logoHref="/"
  ogImage="/images/hero-cover.jpeg"
  showInsights={true}
  insightsLabel="Insights"
  insightsHref="/insights"
  showMarketing={true}
  marketingHref="/"
  marketingLabel="Digital Investment"
  connectHref="#contact"
  connectLabel="Connect"
>
  <Hero />
  <About />
  <Pillars />
  <HowWeWork />
  <TechEcosystem />
  <Services />
  <Collective />
  <Contact />
  <Footer connectHref="/marketing#contact" siteSwitch={{ href: '/', label: 'Digital Investment' }} />
</PreviewLayout>
